{
  "name": "react-csp-ssr",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "webpack --config webpack.client.js && webpack --config webpack.server.js",
    "watch:client": "webpack --watch --config webpack.client.js",
    "watch:server": "webpack --watch --config webpack.server.js",
    "dev:server2": "cross-env NODE_ENV=development nodemon dist/server.bundle.js",
    "dev": "concurrently -k -n CLIENT,SERVER,NODEMON -c green,blue,yellow \"npm:watch:client\" \"npm:watch:server\" \"npm:dev:server\"",
    "dev:server": "wait-on dist/server.bundle.js && cross-env NODE_ENV=development nodemon dist/server.bundle.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@material-ui/core": "4",
    "@material-ui/styles": "4",
    "express": "^4.18.2",
    "react": "16.14.0",
    "react-dom": "16.14.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.1",
    "@babel/preset-env": "^7.24.1",
    "@babel/preset-react": "^7.24.1",
    "babel-loader": "^8.3.0",
    "clean-webpack-plugin": "^3.0.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "css-loader": "^5.2.7",
    "html-webpack-plugin": "^4.5.2",
    "nodemon": "^2.0.22",
    "style-loader": "^2.0.0",
    "wait-on": "^8.0.3",
    "webpack": "^4.46.0",
    "webpack-cli": "^3.3.12",
    "webpack-node-externals": "^1.7.2"
  }
}
